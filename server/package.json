{
  "name": "@dicerace/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@dicerace/game": "*",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/websocket": "^11.0.1",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
