generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  matches     MatchPlayer[]
  leaderboard LeaderboardEntry?
}

model Match {
  id          String    @id @default(cuid())
  roomName    String
  seed        Int
  playerCount Int
  // plain id, not a relation: it can point at someone who forfeited, and
  // we never need to join on it (the won flag on MatchPlayer covers that)
  winnerId    String?
  endReason   String // "finished" | "forfeit"
  // [{ playerId, action }] -- the game is deterministic so seed + this = full replay
  actions     Json
  startedAt   DateTime
  endedAt     DateTime  @default(now())

  players MatchPlayer[]

  @@index([endedAt])
}

model MatchPlayer {
  id         String  @id @default(cuid())
  matchId    String
  userId     String
  finalScore Int
  placement  Int
  won        Boolean
  forfeited  Boolean @default(false)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  // "my match history" = all rows for one user
  @@index([userId])
}

model LeaderboardEntry {
  id          String   @id @default(cuid())
  userId      String   @unique
  score       Int      @default(1000)
  wins        Int      @default(0)
  losses      Int      @default(0)
  gamesPlayed Int      @default(0)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The leaderboard page is always "top N by score". Without this index
  // Postgres has to scan and sort the whole table on every request; with a
  // descending index it can just read the first N entries. It costs a bit on
  // each score update, which is fine because reads vastly outnumber writes.
  @@index([score(sort: Desc)])
}
